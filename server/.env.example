# Copie para server/.env e preencha (o ficheiro .env não vai para o Git).
#
# Neon: painel do projeto → "Connect" → copie a URI "psql" / Node.
# Exemplo (não é real): postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Com esta variável definida, o servidor usa PostgreSQL em vez de SQLite.
DATABASE_URL=

# Só para Postgres em localhost/Docker sem TLS. Com Neon, omita ou comente esta linha.
# DATABASE_SSL=false

# PORT=3001
# NODE_ENV=development
